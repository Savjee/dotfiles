#!/bin/bash
# Start Helium with a smaller UI (toolbar, icons, tabs, menus) on the MacBook display.
#
# Helium (Chromium) takes its UI font from GTK but ignores the text-scaling-factor
# that `omarchy display text size` sets, so its UI comes out much larger than the
# rest of the desktop. To fix the font, point GLib at a keyfile settings backend
# for Helium only: a copy of the current theme settings with just the font size
# changed.
#
# Sharpness: through wp_fractional_scale, Hyprland leaves Chromium at scale 1
# (devicePixelRatio ~0.9 on this scale-2 screen), so Helium renders at 1x and
# Hyprland upscales it 2x, which makes everything soft. With the
# WaylandFractionalScaleV1 feature disabled, Chromium uses the integer output
# scale and --force-device-scale-factor sets the real render scale:
# 2 = normal size, 1.7 = 15% smaller and still crisp. Keep the page zoom at 100%.
# The UI font scales with it, so HELIUM_UI_FONT_SIZE is raised to compensate
# (9.5 x 0.85 ~ 8pt on screen).
HELIUM_UI_SCALE=1.7
HELIUM_UI_FONT_SIZE=9.5

keyfile="${XDG_CONFIG_HOME:-$HOME/.config}/glib-2.0/settings/keyfile"
schema=org.gnome.desktop.interface
font="$(gsettings get $schema font-name | tr -d "'")"
mkdir -p "${keyfile%/*}"
{
  echo "[${schema//.//}]"
  for key in gtk-theme icon-theme cursor-theme cursor-size color-scheme; do
    echo "$key=$(gsettings get $schema "$key")"
  done
  echo "font-name='${font% *} $HELIUM_UI_FONT_SIZE'"
} >"$keyfile"

export GSETTINGS_BACKEND=keyfile
exec /usr/bin/helium-browser --disable-features=WaylandFractionalScaleV1 \
  --force-device-scale-factor="$HELIUM_UI_SCALE" "$@"
