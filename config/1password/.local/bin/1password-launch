#!/usr/bin/env bash
set -euo pipefail

# Display workarounds are opt-in, defined by the selected machine package.
settings=$HOME/.config/omarchy/machine/electron.env
if [[ -r $settings ]]; then
  # shellcheck source=/dev/null
  source "$settings"
fi

has_scale=0
for arg in "$@"; do
  case "$arg" in --force-device-scale-factor|--force-device-scale-factor=*) has_scale=1 ;; esac
done
if [[ -n ${OMARCHY_ELECTRON_SCALE_FACTOR:-} && $has_scale == 0 ]]; then
  set -- "--force-device-scale-factor=$OMARCHY_ELECTRON_SCALE_FACTOR" "$@"
fi
exec /opt/1Password/1password "$@"
