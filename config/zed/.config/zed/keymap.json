[
  {
    "bindings": {
      "cmd-!": "workspace::ToggleBottomDock",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-cmd-b": "workspace::ToggleLeftDock",
      "cmd-b": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "cmd-l": "agent::AddSelectionToThread",
      "cmd-k": "assistant::InlineAssist",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "cmd-k": "assistant::InlineAssist",
    },
  },
  // Command arrives as Control. These are the VS Code chords vim was eating.
  // Option stays Super (`cmd-` above). Ctrl-O/I, Ctrl-R, Ctrl-U, and Ctrl-[ stay vim.
  {
    "context": "Editor && !Terminal && vim_mode == insert && !menu && !showing_completions && !showing_signature_help",
    "bindings": {
      "ctrl-s": "workspace::Save",
      "ctrl-shift-s": "workspace::SaveAs",
      "ctrl-alt-s": "workspace::SaveAll",
      "ctrl-z": "editor::Undo",
      "ctrl-shift-z": "editor::Redo",
      "ctrl-x": "editor::Cut",
      "ctrl-c": "editor::Copy",
      "ctrl-v": "editor::Paste",
      "super-c": "editor::Copy",
      "super-v": "editor::Paste",
      "ctrl-super-c": "editor::Copy",
      "ctrl-super-v": "editor::Paste",
      "ctrl-a": "editor::SelectAll",
      "ctrl-l": "editor::SelectLine",
      "ctrl-f": "buffer_search::Deploy",
      "ctrl-shift-f": "pane::DeploySearch",
      "ctrl-p": "file_finder::Toggle",
      "ctrl-shift-p": "command_palette::Toggle",
      "ctrl-n": "workspace::NewFile",
      "ctrl-shift-n": "workspace::NewWindow",
      "ctrl-w": ["pane::CloseActiveItem", { "close_pinned": false }],
      "ctrl-shift-w": "workspace::CloseWindow",
      "ctrl-t": "project_symbols::Toggle",
      "ctrl-g": "go_to_line::Toggle",
      "ctrl-b": "workspace::ToggleLeftDock",
      "ctrl-j": "workspace::ToggleBottomDock",
      "ctrl-d": ["editor::SelectNext", { "replace_newest": false }],
      "ctrl-shift-k": "editor::DeleteLine",
      "ctrl-/": ["editor::ToggleComments", { "advance_downwards": false, "comment_empty_lines": true }],
      "ctrl-.": "editor::ToggleCodeActions",
    },
  },
  {
    "context": "Editor && !Terminal && vim_mode == replace && !menu",
